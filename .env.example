# ============================================================
# ANCHOR — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any .env file containing real secrets.
# ============================================================

# Resend (https://resend.com) — Email delivery for grievance submissions
# Required for the AnchorChat /api/grievance email notification to work.
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The "From" address for grievance notification emails.
# Must be a verified sender domain in your Resend account.
# Example: anchor@yourdomain.com
RESEND_FROM_EMAIL=anchor@yourdomain.com

# The address that receives grievance notification emails.
# Can be any email address you control.
GRIEVANCE_TO_EMAIL=your@email.com
